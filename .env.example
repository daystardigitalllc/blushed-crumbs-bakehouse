APP_NAME="BakeBox SaaS Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://bakery_pro.test

LOG_CHANNEL=stack
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bakebox_saas
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file

# Leading dot required — shares the login session cookie between doughmain.pro
# and all of its tenant subdomains (client.doughmain.pro etc). Without this,
# redirecting a logged-in user to their subdomain logs them right back out.
SESSION_DOMAIN=.doughmain.pro

MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="orders@daystardigital.co"
MAIL_FROM_NAME="Doughmain"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Laravel Forge API — used to auto-request SSL for verified custom domains.
# Leave blank to disable (custom domains still verify and route, just without auto-SSL).
FORGE_API_TOKEN=
FORGE_SERVER_ID=
FORGE_SITE_ID=

# Stripe secret key — used to verify Pro plan payments and cancel subscriptions.
STRIPE_SECRET=

# Gemini model used to generate the hero/promo/CTA background images during site
# generation (uses the same GEMINI_API_KEY above — no separate key needed).
# Leave blank to fall back to that default; if generation fails for any reason,
# sections fall back to their existing gradient background.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
