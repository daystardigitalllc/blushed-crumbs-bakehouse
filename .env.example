APP_NAME="BakeBox SaaS Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://bakery_pro.test

LOG_CHANNEL=stack
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bakebox_saas
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file

MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="orders@daystardigital.co"
MAIL_FROM_NAME="Doughmain"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Laravel Forge API — used to auto-request SSL for verified custom domains.
# Leave blank to disable (custom domains still verify and route, just without auto-SSL).
FORGE_API_TOKEN=
FORGE_SERVER_ID=
FORGE_SITE_ID=
